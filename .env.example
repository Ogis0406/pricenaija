# Required for migrations, seeding and the API. Set a private MySQL URL in your local .env.
DATABASE_URL=

# Local server options
PORT=3000
NODE_ENV=development
LOCAL_UPLOAD_DIR=.local-storage

# Optional transactional email. All three are required for real production delivery.
RESEND_API_KEY=
MAIL_FROM=
PUBLIC_APP_URL=

# Optional durable Manus object-storage integration. Omit both for local development uploads.
MANUS_API_URL=
MANUS_API_KEY=

# One-time backend administrator provisioning only. Remove after use.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Optional Manus compatibility settings; not required for email/password login.
MANUS_PROJECT_ID=
MANUS_JWT_SECRET=
MANUS_OAUTH_API_URL=
